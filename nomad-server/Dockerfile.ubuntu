# Nomad server with embedded Fortran worker for Mac development
# Ubuntu-based to match Nomad's glibc dependency

# Build Fortran worker with real MQTT (using Paho MQTT C library)
FROM ubuntu:22.04 AS fortran-builder

RUN apt-get update && apt-get install -y \
    gfortran \
    gcc \
    make \
    libgomp1 \
    libpaho-mqtt-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY fortran-compute/src/*.f90 ./src/
COPY fortran-compute/src/*.c ./src/
COPY fortran-compute/Makefile ./Makefile

# Build with the same Makefile that creates working local binaries
RUN make -f Makefile clean && CONTAINER_BUILD=1 make -f Makefile all && \
    echo "Fortran worker with temporal gating built successfully"

# Final image: Ubuntu with Nomad and Fortran worker
FROM ubuntu:22.04

# Install runtime dependencies (including MQTT C library)
RUN apt-get update && apt-get install -y \
    libgfortran5 \
    libgomp1 \
    libpaho-mqtt1.3 \
    ca-certificates \
    wget \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Copy Nomad binary from official image
COPY --from=hashicorp/nomad:1.8 /bin/nomad /usr/local/bin/nomad

# Copy Fortran worker binary
COPY --from=fortran-builder /build/bin/semantic_diffusion_cpu /usr/local/bin/

# Copy entrypoint script, job definition, and client config
COPY nomad-server/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY nomad-server/client.hcl /etc/nomad.d/client.hcl
COPY nomad-jobs/gpu-compute-rawexec.nomad.hcl /etc/nomad.d/gpu-compute.nomad.hcl

# Verify binaries are executable
RUN chmod +x /usr/local/bin/nomad /usr/local/bin/semantic_diffusion_cpu /usr/local/bin/entrypoint.sh && \
    nomad version && \
    echo "Fortran worker ready at /usr/local/bin/semantic_diffusion_cpu"

# Create nomad user and directories
RUN groupadd nomad && \
    useradd -r -g nomad nomad && \
    mkdir -p /opt/nomad/data && \
    chown -R nomad:nomad /opt/nomad

# Nomad configuration will be mounted from host
EXPOSE 4646 4647 4648

# Run Nomad with automatic job registration
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
