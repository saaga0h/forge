# Nomad server with embedded Fortran worker for Mac development
# Uses raw_exec driver to run the worker binary directly

# Build Fortran worker in separate stage
FROM alpine:3.20 AS fortran-builder

RUN apk add --no-cache \
    gfortran \
    gcc \
    make \
    musl-dev \
    paho-mqtt-c-dev

WORKDIR /build
COPY fortran-compute/src/*.f90 ./src/
COPY fortran-compute/src/*.c ./src/
COPY fortran-compute/Makefile.alpine ./Makefile

RUN make -f Makefile all && \
    echo "Fortran worker built successfully"

# Final image: Alpine with Nomad and Fortran worker
FROM alpine:3.20

# Install runtime dependencies
RUN apk add --no-cache \
    libgfortran \
    libgomp \
    paho-mqtt-c \
    libstdc++ \
    ca-certificates \
    dumb-init \
    su-exec \
    wget \
    unzip

# Copy Nomad binary from official image
COPY --from=hashicorp/nomad:1.8 /bin/nomad /usr/local/bin/nomad

# Copy Fortran worker binary
COPY --from=fortran-builder /build/bin/semantic_diffusion_cpu /usr/local/bin/

# Verify binaries are executable
RUN chmod +x /usr/local/bin/nomad /usr/local/bin/semantic_diffusion_cpu && \
    nomad version && \
    echo "Fortran worker ready at /usr/local/bin/semantic_diffusion_cpu"

# Create nomad user and directories
RUN addgroup nomad && \
    adduser -S -G nomad nomad && \
    mkdir -p /opt/nomad/data && \
    chown -R nomad:nomad /opt/nomad

# Nomad configuration will be mounted from host
EXPOSE 4646 4647 4648

# Run Nomad in dev mode
ENTRYPOINT ["/usr/local/bin/nomad"]
CMD ["agent", "-dev", "-bind=0.0.0.0"]
